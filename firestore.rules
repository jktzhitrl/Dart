rules_version = '2';

// Darts Tournament Manager Pro - Cloud Firestore Security Rules
//
// Rollen:  spectator < player < scorer < director < admin
//  * Globale Rolle:  users/{uid}.role  (nur Admins dürfen sie ändern)
//  * Turnierrolle:   tournaments/{tid}/members/{uid}.role
// Effektiv gilt die jeweils höhere Rolle.
//
// Alle Schreibzugriffe auf Turniere und Begegnungen sind versioniert
// (optimistische Sperre): version muss exakt um 1 steigen. Dadurch kann ein
// Schreiber mit veraltetem Stand (Verbindungsabbruch, zweites Gerät) nichts
// überschreiben.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ Hilfsfunktionen
    function signedIn() { return request.auth != null; }
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function uid() { return request.auth.uid; }

    function userDoc() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function globalRole() {
      return hasAccount() && exists(/databases/$(database)/documents/users/$(uid()))
        ? userDoc().role : 'spectator';
    }
    function isAdmin() { return globalRole() == 'admin'; }

    function memberPath(tid) {
      return /databases/$(database)/documents/tournaments/$(tid)/members/$(uid());
    }
    function isMember(tid) { return hasAccount() && exists(memberPath(tid)); }
    function memberRole(tid) { return get(memberPath(tid)).data.role; }

    function tournament(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)).data;
    }
    function activeTournament(tid) {
      return tournament(tid).get('trash', null) == null;
    }
    function canReadTournamentMatch(game) {
      return activeTournament(game.tournamentId)
        && (isMember(game.tournamentId)
          || (game.isPublic == true && tournament(game.tournamentId).isPublic == true));
    }

    function devicePath(deviceUid) {
      return /databases/$(database)/documents/board_devices/$(deviceUid);
    }
    function tabletPath(tid, boardId) {
      return /databases/$(database)/documents/tournaments/$(tid)/tablets/$(boardId);
    }
    function isTablet() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function tabletAt(tid, boardId) {
      let device = get(devicePath(uid())).data;
      return device.tournamentId == tid && device.boardId == boardId
        && get(tabletPath(tid, boardId)).data.deviceUid == uid();
    }
    function tabletIn(tid) {
      return isTablet() && exists(devicePath(uid()))
        && tabletAt(tid, get(devicePath(uid())).data.boardId);
    }
    function tabletScores(mid, game) {
      let device = get(devicePath(uid())).data;
      let board = tournament(game.tournamentId).boards[device.boardIndex];
      return board.id == game.boardId && board.currentMatchId == mid;
    }

    function isDirector(tid) {
      return isAdmin() || (isMember(tid) && memberRole(tid) == 'director');
    }
    function isStaff(tid) {
      // darf Ergebnisse eingeben: Schreiber, Leitung, Admin (global oder im Turnier)
      return isDirector(tid)
        || globalRole() in ['scorer', 'director']
        || (isMember(tid) && memberRole(tid) == 'scorer');
    }

    function visitsOf(data) { return data.x01.visits; }
    function lastVisit(data) { return data.x01.visits[data.x01.visits.size() - 1]; }
    function x01Plausible() {
      return request.resource.data.get('x01', null) == null
        || resource.data.get('x01', null) == null
        || (visitsOf(request.resource.data).size() <= visitsOf(resource.data).size() + 1
            && (visitsOf(request.resource.data).size() == 0
                || (lastVisit(request.resource.data).points >= 0
                    && lastVisit(request.resource.data).points <= 180
                    && lastVisit(request.resource.data).dartsThrown >= 1
                    && lastVisit(request.resource.data).dartsThrown <= 3)));
    }

    function validCorrection() {
      let result = request.resource.data.get('correction', {});
      return resource.data.status == 'confirmed' && request.resource.data.status == 'confirmed'
        && result.keys().hasOnly(['legsA', 'legsB', 'winnerIndex'])
        && result.legsA is int && result.legsB is int
        && result.legsA >= 0 && result.legsB >= 0 && result.winnerIndex in [0, 1]
        && request.resource.data.winnerId == resource.data.playerIds[result.winnerIndex]
        && onlyChanges(['correction', 'winnerId', 'version', 'updatedAt']);
    }

    function registrationAdded() {
      let list = request.resource.data.registrations;
      return list[list.size() - 1];
    }

    function versionBumped() {
      return request.resource.data.version == resource.data.version + 1;
    }
    function unchanged(fields) {
      return request.resource.data.diff(resource.data).unchangedKeys().hasAll(fields);
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      // Neue Konten starten IMMER als 'player' - keine Selbstvergabe von Rechten.
      allow create: if hasAccount() && userId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'player';
      allow update: if signedIn() && (
        isAdmin()
        || (userId == uid() && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid));
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------ players
    match /players/{playerId} {
      allow read: if hasAccount();
      allow create: if hasAccount()
        && request.resource.data.id == playerId
        && (request.resource.data.uid == null || request.resource.data.uid == uid());
      allow update: if hasAccount() && request.resource.data.id == playerId && (
        resource.data.uid == uid()
        || isAdmin()
        || (resource.data.uid == null && globalRole() in ['scorer', 'director']))
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- tournaments
    match /tournaments/{tid} {
      allow get: if isAdmin() || isMember(tid) || resource.data.isPublic == true || tabletIn(tid);
      allow list: if isAdmin() || isMember(tid) || resource.data.isPublic == true;

      // Nur Admins legen Turniere an; Start immer mit version 1.
      allow create: if isAdmin()
        && request.resource.data.createdBy == uid()
        && request.resource.data.version == 1
        && !request.resource.data.keys().hasAny(['trash'])
        && (request.resource.data.get('isDuo', false) == false ||
          (request.resource.data.isDuo == true
            && request.resource.data.format == 'groupsKnockout'
            && request.resource.data.gameType in ['x301', 'x501', 'x701', 'x1001']));

      // Moving to the trash switches off public discovery. Restore the original
      // visibility and leave the complete tournament data untouched.
      allow update: if isAdmin() && versionBumped()
        && onlyChanges(['trash', 'isPublic', 'version'])
        && (
          (resource.data.get('trash', null) == null
            && request.resource.data.trash.keys().hasOnly(['movedAt', 'wasPublic'])
            && request.resource.data.trash.movedAt is string
            && request.resource.data.trash.wasPublic == resource.data.isPublic
            && request.resource.data.isPublic == false)
          || (resource.data.get('trash', null) != null
            && !request.resource.data.keys().hasAny(['trash'])
            && request.resource.data.isPublic == resource.data.trash.wasPublic)
        );

      allow update: if signedIn() && versionBumped() && activeTournament(tid)
        && request.resource.data.get('trash', null) == null
        && request.resource.data.get('isDuo', false) == resource.data.get('isDuo', false)
        && unchanged(['createdBy', 'inviteCode', 'format', 'gameType', 'createdAt', 'id', 'isPublic'])
        && (
          // Turnierleitung: alles
          isDirector(tid)
          // Selbstanmeldung: genau ein Teilnehmer hinzufügen, nur in der Anmeldephase
          || (hasAccount() && (resource.data.isPublic || isMember(tid))
              && onlyChanges(['registrations', 'version'])
              && resource.data.status == 'registration'
              && resource.data.get('duoTeams', []).size() == 0
              && request.resource.data.registrations.size() == resource.data.registrations.size() + 1
              && request.resource.data.registrations.hasAll(resource.data.registrations)
              && registrationAdded().id == userDoc().playerId
              && (resource.data.get('isDuo', false) == false ||
                (registrationAdded().keys().hasOnly(['id', 'name', 'seed'])
                  && registrationAdded().get('seed', null) == null)))
          // Schreiber: nur Boardbelegung
          || (onlyChanges(['boards', 'version']) && isStaff(tid))
        );
      allow delete: if isAdmin();

      match /tablets/{boardId} {
        function validLocation() {
          let data = request.resource.data;
          return data.tournamentId == tid && data.boardId == boardId
            && data.boardIndex is int && data.boardIndex >= 0
            && tournament(tid).boards[data.boardIndex].id == boardId;
        }

        allow get: if isDirector(tid)
          || (isTablet() && resource.data.deviceUid == uid() && tabletAt(tid, boardId));
        allow list: if isDirector(tid);
        allow create, update: if isDirector(tid) && activeTournament(tid) && validLocation()
          && (resource == null || resource.data.deviceUid == null)
          && request.resource.data.keys().hasOnly(
              ['tournamentId', 'boardId', 'boardIndex', 'deviceUid', 'code', 'expiresAt'])
          && request.resource.data.deviceUid == null
          && request.resource.data.code is string && request.resource.data.code.size() == 20
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt < request.time + duration.value(12, 'm');
        allow update: if isTablet() && activeTournament(tid) && resource.data.deviceUid == null
          && resource.data.expiresAt > request.time
          && request.resource.data.deviceUid == uid()
          && request.resource.data.proof == resource.data.code
          && onlyChanges(['deviceUid', 'proof'])
          && getAfter(devicePath(uid())).data.tournamentId == tid
          && getAfter(devicePath(uid())).data.boardId == boardId
          && getAfter(devicePath(uid())).data.boardIndex == resource.data.boardIndex;
        allow delete: if isDirector(tid) || (isTablet()
          && resource.data.deviceUid == uid() && tabletAt(tid, boardId)
          && !existsAfter(devicePath(uid())));
      }

      match /members/{memberId} {
        allow read: if signedIn() && (isAdmin() || isMember(tid) || memberId == uid());
        // Leitung vergibt Schreiber/Spieler; nur Admin vergibt Leitung. Selbst: nur 'player'.
        allow create, update: if hasAccount() && activeTournament(tid) && request.resource.data.uid == memberId && (
          isAdmin()
          || (isDirector(tid) && request.resource.data.role in ['player', 'scorer'])
          || (memberId == uid() && request.resource.data.role == 'player'
              && !exists(memberPath(tid))
              && (tournament(tid).isPublic
                  || request.resource.data.get('inviteCode', '') == tournament(tid).inviteCode)));
        allow delete: if isDirector(tid);
      }
    }

    // Für die eigenen Mitgliedschaften darf nach uid über alle Turniere gesucht werden.
    match /{parent=**}/members/{memberId} {
      allow list: if hasAccount() && resource.data.uid == uid();
    }

    match /board_devices/{deviceUid} {
      function validPair() {
        let row = request.resource.data;
        let board = getAfter(tabletPath(row.tournamentId, row.boardId)).data;
        return row.keys().hasOnly(['tournamentId', 'boardId', 'boardIndex'])
          && row.boardIndex is int && row.boardIndex >= 0
          && board.deviceUid == deviceUid && board.boardIndex == row.boardIndex;
      }
      allow get, delete: if isTablet() && uid() == deviceUid;
      allow create: if isTablet() && uid() == deviceUid && validPair();
      allow update: if isTablet() && uid() == deviceUid && validPair()
        && (request.resource.data == resource.data
          || !exists(tabletPath(resource.data.tournamentId, resource.data.boardId))
          || get(tabletPath(resource.data.tournamentId, resource.data.boardId)).data.deviceUid != deviceUid);
    }

    match /tournament_invites/{code} {
      allow get: if hasAccount();
      allow create, update: if request.resource.data.keys().hasOnly(['tournamentId'])
        && isDirector(request.resource.data.tournamentId)
        && getAfter(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.inviteCode == code
        && (resource == null || resource.data.tournamentId == request.resource.data.tournamentId);
    }

    // ------------------------------------------------------------------ matches
    match /matches/{mid} {
      function readsMatch(game) {
        return game.tournamentId == null
          ? (game.isPublic == true || (hasAccount() && game.scorerUid == uid()))
          : canReadTournamentMatch(game);
      }

      allow list: if isAdmin() || readsMatch(resource.data);
      allow get: if readsMatch(resource.data)
        || (isAdmin() && (resource.data.tournamentId == null || activeTournament(resource.data.tournamentId)));

      allow get: if isTablet() && resource.data.tournamentId != null
        && resource.data.boardId != null
        && tabletAt(resource.data.tournamentId, resource.data.boardId)
        && activeTournament(resource.data.tournamentId)
        && tabletScores(mid, resource.data);

      allow update: if isTablet() && resource.data.tournamentId != null
        && resource.data.boardId != null
        && tabletAt(resource.data.tournamentId, resource.data.boardId)
        && activeTournament(resource.data.tournamentId)
        && tabletScores(mid, resource.data)
        && versionBumped() && x01Plausible()
        && resource.data.status in ['live', 'paused', 'awaitingConfirmation']
        && request.resource.data.status in ['live', 'paused', 'awaitingConfirmation']
        && (request.resource.data.status != 'awaitingConfirmation' || request.resource.data.winnerId != null)
        && onlyChanges(['status', 'version', 'updatedAt', 'winnerId', 'x01', 'cricket', 'clock', 'draft']);

      // Turnier-Begegnung: Schreiber/Leitung. Freundschaftsspiel: jeder Angemeldete.
      allow create: if hasAccount() && request.resource.data.version == 0
        && request.resource.data.status in ['scheduled', 'live']
        && !request.resource.data.keys().hasAny(['correction']) && (
        request.resource.data.tournamentId == null
          ? request.resource.data.scorerUid == uid()
          : isStaff(request.resource.data.tournamentId)
            && activeTournament(request.resource.data.tournamentId)
            && request.resource.data.isPublic == tournament(request.resource.data.tournamentId).isPublic);

      allow update: if hasAccount() && versionBumped()
        && unchanged(['id', 'tournamentId', 'planMatchId', 'gameType', 'players', 'playerIds', 'createdAt', 'isPublic'])
        && resource.data.status != 'voided'
        && (resource.data.tournamentId == null || resource.data.status != 'confirmed'
            || request.resource.data.status in ['confirmed', 'voided'])
        && (
          resource.data.tournamentId == null
            ? (resource.data.scorerUid == uid() || isAdmin())
            : isStaff(resource.data.tournamentId) && activeTournament(resource.data.tournamentId))
        // Offizielle Änderungen und Annullierungen bleiben der Turnierleitung vorbehalten.
        && ((request.resource.data.get('correction', null) == resource.data.get('correction', null)
             && request.resource.data.status != 'voided'
             && (request.resource.data.status != 'confirmed' || resource.data.tournamentId == null))
            || (resource.data.tournamentId != null && isDirector(resource.data.tournamentId)
                && (request.resource.data.get('correction', null) == resource.data.get('correction', null)
                    || validCorrection())))
        // Eingabe-Plausibilität (nur X01): höchstens eine neue Aufnahme pro Schreibvorgang,
        // Punkte 0..180, Darts 1..3.
        && x01Plausible();

      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------- audit_logs
    match /audit_logs/{aid} {
      allow create: if hasAccount() && request.resource.data.uid == uid();
      allow read: if signedIn() && (isAdmin() || globalRole() == 'director'
        || (resource.data.tournamentId != null && isMember(resource.data.tournamentId)
            && memberRole(resource.data.tournamentId) == 'director'));
      allow update, delete: if false; // append-only
    }

    // Alles andere ist gesperrt.
    match /{document=**} { allow read, write: if false; }
  }
}
